# Demo Payment API — Environment Config
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#
# NEVER commit .env to git — it contains secrets!

# Sentry DSN — Required for error monitoring
# Get it from: Sentry → Project Settings → Client Keys (DSN)
SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id

# Slack Incoming Webhook URL — Optional, for posting alerts to #incidents
# Get it from: https://api.slack.com/apps → Your App → Incoming Webhooks → Add New
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx
